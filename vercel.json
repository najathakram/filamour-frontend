{
  "rewrites": [
    { "source": "/admin",        "destination": "/Dashboard.html" },
    { "source": "/admin/:path*", "destination": "/Dashboard.html" },
    { "source": "/",             "destination": "/Filamour.html" }
  ],
  "headers": [
    {
      "source": "/Dashboard.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
